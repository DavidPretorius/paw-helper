{
  "name": "Nordic Banking",
  "baseTheme": "carbonGrey10",
  "properties": {
    "defaultLocale": "Default",
    "fredIsRed": true,
    "defaultZoom": "1"
  },
  "layout": {
    "pageSize": {
      "width": 1750,
      "height": 900
    },
    "layoutPositioning": "absolute",
    "fitPage": false
  },
  "authoringPalette": {
    "backgrounds": {
      "primary": "#F0F3F7",
      "secondary": "#FFFFFF"
    },
    "accents": [
      "#003366",
      "#0055A4",
      "#2E86C1",
      "#1ABC9C",
      "#E74C3C",
      "#F39C12",
      "#7D3C98",
      "#5DADE2"
    ]
  },
  "semantic": {
    "backgrounds": {
      "dashboard": "#F0F3F7",
      "tab": "#F0F3F7",
      "surface": "#FFFFFF",
      "surfaceAlt": "#E8EDF2",
      "rowHeader": "#003366",
      "columnHeader": "#003366",
      "data": "#FFFFFF",
      "spacer": "#FFFFFF",
      "grid": "transparent",
      "syncTile": "transparent",
      "shape": "#FFFFFF"
    },
    "neutrals": {
      "border": "#C5CED8",
      "text": "#1B2A3D",
      "mutedText": "#6B7B8D",
      "headerText": "#3D5068",
      "appBar": "#0A1929",
      "ghostBorder": "#A0B0C0"
    },
    "accents": {
      "primary": "#003366",
      "secondary": "#0055A4",
      "tertiary": "#5DADE2",
      "interactive": "#0055A4",
      "highlight": "#D6E4F0",
      "selection": "#B8D4F0",
      "negative": "#E74C3C",
      "chartSeries": [
        "#003366",
        "#0055A4",
        "#2E86C1",
        "#1ABC9C",
        "#E74C3C",
        "#F39C12",
        "#7D3C98"
      ]
    },
    "typography": {
      "fonts": {
        "body": "Poppins-Light",
        "ui": "Poppins-Regular",
        "heading": "Poppins-Bold",
        "grid": "IBMPlexSans-Light",
        "rowHeader": "IBMPlexSans-Regular"
      },
      "scale": {
        "widgetHeading": {
          "size": "14px",
          "weight": "700"
        },
        "body": {
          "size": "14px",
          "weight": "400"
        },
        "caption": {
          "size": "12px",
          "weight": "400"
        },
        "button": {
          "size": "14px",
          "weight": "400"
        },
        "selector": {
          "size": "16px",
          "weight": "400"
        },
        "gridCell": {
          "size": "12px",
          "weight": "400"
        },
        "kpiValue": {
          "size": "22px",
          "weight": "700"
        }
      }
    },
    "radii": {
      "card": 6,
      "button": 6,
      "text": 4,
      "shape": 0
    }
  },
  "visuals": {
    "liveByVisId": {
      "pasinglecell": {
        "showTitle": false,
        "titleHtml": {
          "translationTable": {
            "Default": "\u003cdiv class=\"widgetTitlesmallTitle\"\u003e\u003cdiv class=\"textArea\"\u003e\u003cspan class=\"textFittedresponsiveColorresponsiveFontSizeresponsiveFontFamily\"\u003e\u003cp style=\"text-align: center;\"\u003e\u003cspan style=\"font-size: 16px;\"\u003eClick to edit title\u003c/span\u003e\u003c/p\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e"
          }
        },
        "responsiveTitle": {
          "translationTable": {
            "Default": "Click to edit title"
          }
        },
        "fillColor": "color1",
        "borderColor": "color2",
        "borderRadius": 6
      }
    },
    "charts": {
      "defaults": {
        "showTitle": true,
        "properties": {
          "widget.legend.position": "top",
          "widget.legend.splitter": false,
          "widget.legend.titleVisible": false
        }
      },
      "cartesianDefaults": {
        "properties": {
          "itemAxis.title.visible": false,
          "valueAxis.title.visible": false,
          "itemAxis.gridLines.visible": true,
          "itemAxis.ticks.labels.visible": true,
          "valueAxis.ticks.labels.visible": true,
          "itemAxis.line.visible": true,
          "valueAxis.line.visible": true,
          "valueAxis.gridLines.dashPattern.type": "solid",
          "itemAxis.gridLines.dashPattern.type": "solid"
        }
      },
      "pieDefaults": {
        "globalFormat": {
          "ZerosOption": "AUTO",
          "ScalingFactor": 1,
          "Notation": "COMPACTSHORT",
          "Units": {
            "UnitType": "BASE"
          },
          "Precision": {
            "MaxFraction": 1,
            "MinFraction": 1
          },
          "GroupingStrategy": "AUTO",
          "SignDisplay": "AUTO",
          "Locale": "en",
          "selectedFormat": "none"
        },
        "properties": {
          "widget.legend.position": "bottom",
          "donut.hole.radius": 0.65,
          "label.percentage": true,
          "labels.visible": true
        }
      },
      "byVisId": {
        "com.ibm.vis.rave2line": {
          "properties": {
            "lineWithPoints.symbol": "circle",
            "interpolate": "linear",
            "valueLabels.visible": true
          }
        },
        "com.ibm.vis.rave2bundlearea": {
          "properties": {
            "widget.legend.display": true,
            "lineWithPoints.symbol": "circle",
            "interpolate": "linear",
            "valueLabels.visible": false
          }
        },
        "com.ibm.vis.rave2bundlebar": {
          "properties": {
            "valueLabels.visible": true,
            "itemAxis.ticks.labels.alignment": "left"
          }
        },
        "com.ibm.vis.rave2bundlecolumn": {
          "properties": {
            "valueLabels.visible": false
          }
        },
        "com.ibm.vis.rave2bundlepie": {
          "properties": {
            "inner.label.title": {
              "translationTable": {
                "Default": " "
              }
            }
          }
        }
      }
    },
    "mdv": {
      "genericProperties": {
        "displayMode": "grid",
        "drawBorderLines": true,
        "drawZebraStrips": true,
        "showInnerBox": false,
        "isColorCells": false,
        "isGridEditable": true,
        "boldConsolidation": true,
        "abbreviateNumbers": false,
        "useCellFontSize": true,
        "isColumnIndent": true,
        "isRowIndent": true,
        "isShowExpandCollapseColumns": true,
        "isShowExpandCollapseRows": true,
        "UseColumnFocusedCharting": false
      }
    },
    "syncTile": {
      "data": {
        "hasSearchBar": true,
        "multipleSelection": false,
        "showHeader": true,
        "showIcon": false,
        "isShowOverflowMenu": false
      }
    },
    "singleCell": {
      "genericProperties": {
        "dimensionOverview_name": false,
        "dimensionOverview_iconography": true,
        "dimensionOverview_contextinformation": false,
        "dimensionOverview_sectionheaders": false,
        "dimensionOverview_sectionicons": false,
        "displayMode": "grid",
        "syncInfo": {},
        "boldConsolidation": true,
        "CommonAxisRange": true,
        "drawBorderLines": true,
        "isColorCells": false,
        "isColumnIndent": true,
        "isMemberSelectUseRowHeader": false,
        "isDeferredRecalcOnLeafUpdates": false,
        "isRowIndent": true,
        "isAutomaticRowHeaderWidth": true,
        "isShowExpandCollapseRows": true,
        "isShowExpandCollapseColumns": true,
        "UseColumnFocusedCharting": false,
        "rowHeaderWidthValue": {
          "0": 150
        },
        "tableStyle": "gridSummary",
        "isZoom80": null,
        "hideColsHeader": true,
        "hideRowsHeader": true,
        "visible": false,
        "isGridEditable": false,
        "abbreviateNumbers": false,
        "allowConsolidationTypeIn": false,
        "showInnerBox": false,
        "useCellFontSize": true
      },
      "sections": {
        "DataCell": {
          "font-size": "28"
        }
      }
    },
    "image": {
      "objectFit": "contain"
    },
    "conditionalFormatting": {
      "paletteId": "userPaletteColor",

      "rules": []
    }
  }
}
