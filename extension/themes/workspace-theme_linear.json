      "surfaceAlt": "#0F0F10",
      "rowHeader": "#5E6AD2",
      "columnHeader": "#5E6AD2",
      "data": "#16161A",
      "spacer": "#16161A",
      "grid": "transparent",
      "syncTile": "transparent",
      "shape": "#1C1C22"
    },
    "neutrals": {
      "border": "#2D2D35",
      "text": "#EEEEF0",
      "mutedText": "#6E6E80",
      "headerText": "#A8A8B8",
      "appBar": "#08080A",
      "ghostBorder": "#3D3D4D"
