        "showHeader": false,
        "showIcon": false,
        "isShowOverflowMenu": false
      }
    },
    "singleCell": {
      "genericProperties": {
        "dimensionOverview_name": false,
        "dimensionOverview_iconography": true,
        "dimensionOverview_contextinformation": false,
        "dimensionOverview_sectionheaders": false,
        "dimensionOverview_sectionicons": false,
        "displayMode": "grid",
        "syncInfo": {

        },
        "boldConsolidation": true,
        "CommonAxisRange": true,
        "drawBorderLines": true,
        "isColorCells": false,
        "isColumnIndent": true,
        "isMemberSelectUseRowHeader": false,
        "isDeferredRecalcOnLeafUpdates": false,
        "isRowIndent": true,
