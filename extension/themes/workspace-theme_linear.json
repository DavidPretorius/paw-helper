{
  "name": "Linear Dark",
  "baseTheme": "carbonGrey100",
  "properties": {
    "defaultLocale": "Default",
    "fredIsRed": true,
    "defaultZoom": "1"
  },
  "layout": {
    "pageSize": {
      "width": 1750,
      "height": 900
    },
    "layoutPositioning": "absolute",
    "fitPage": false
  },
  "authoringPalette": {
    "backgrounds": {
      "primary": "#0F0F10",
      "secondary": "#16161A"
    },
    "accents": [
      "#5E6AD2",
      "#8B92E8",
      "#2D9CDB",
      "#56CCF2",
      "#9B59B6",
      "#6FCF97",
      "#F2994A",
      "#404580"
    ]
  },
