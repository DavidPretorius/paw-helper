{
  "name": "Parchment",
  "baseTheme": "carbonGrey10",
  "properties": {
    "defaultLocale": "Default",
    "fredIsRed": true,
    "defaultZoom": "1"
  },
  "layout": {
    "pageSize": {
      "width": 1750,
      "height": 900
    },
    "layoutPositioning": "absolute",
    "fitPage": false
  },
  "authoringPalette": {
    "backgrounds": {
      "primary": "#F4EFE4",
      "secondary": "#FDFAF4"
    },
    "accents": [
      "#B5722A",
      "#5D8A5E",
      "#6B8CAD",
      "#C4856A",
      "#8B6BAE",
      "#D4B483",
      "#4A7C6B",
      "#D4965A"
    ]
  },
  "semantic": {
    "backgrounds": {
      "dashboard": "#F4EFE4",
      "tab": "#F4EFE4",
      "surface": "#FDFAF4",
      "surfaceAlt": "#F4EFE4",
      "rowHeader": "#FDFAF4",
      "columnHeader": "#B5722A",
      "data": "#FDFAF4",
      "spacer": "#FDFAF4",
      "grid": "transparent",
      "syncTile": "transparent",
      "shape": "#FDFAF4"
    },
    "neutrals": {
      "border": "#DDD5C5",
      "text": "#2B2318",
      "mutedText": "#9A8F7C",
      "headerText": "#6B5F4E",
      "appBar": "#1C1410",
      "ghostBorder": "#C2B8A4"
    },
    "accents": {
      "primary": "#B5722A",
      "secondary": "#D4965A",
      "tertiary": "#ECC49A",
      "interactive": "#B5722A",
      "highlight": "#EDE3D0",
      "selection": "#E2D4BC",
      "negative": "#C0392B",
      "chartSeries": [
        "#B5722A",
        "#5D8A5E",
        "#6B8CAD",
        "#C4856A",
        "#8B6BAE",
        "#D4B483",
        "#4A7C6B"
      ]
    },
    "typography": {
      "fonts": {
        "body": "Poppins-Light",
        "ui": "Poppins-Regular",
        "heading": "Poppins-Bold",
        "grid": "IBMPlexSans-Light",
        "rowHeader": "IBMPlexSans-Regular"
      },
      "scale": {
        "widgetHeading": {
          "size": "14px",
          "weight": "700"
        },
        "body": {
          "size": "14px",
          "weight": "400"
        },
        "caption": {
          "size": "12px",
          "weight": "400"
        },
        "button": {
          "size": "14px",
          "weight": "400"
        },
        "selector": {
          "size": "16px",
          "weight": "400"
        },
        "gridCell": {
          "size": "12px",
          "weight": "400"
        },
        "kpiValue": {
          "size": "20px",
          "weight": "400"
        }
      }
    },
    "radii": {
      "card": 8,
      "button": 16,
      "text": 4,
      "shape": 0
    }
  },
  "visuals": {
    "liveByVisId": {
      "pasinglecell": {
        "showTitle": false,
        "titleHtml": {
          "translationTable": {
            "Default": "\u003cdiv class=\"widgetTitlesmallTitle\"\u003e\u003cdiv class=\"textArea\"\u003e\u003cspan class=\"textFittedresponsiveColorresponsiveFontSizeresponsiveFontFamily\"\u003e\u003cp style=\"text-align: center;\"\u003e\u003cspan class=\"rt_fontFamilyPoppins-Regular\" style=\"font-size: 16px;\"\u003eClick to edit title\u003c/span\u003e\u003c/p\u003e\u003c/span\u003e\u003c/div\u003e\u003c/div\u003e"
          }
        },
        "responsiveTitle": {
          "translationTable": {
            "Default": "Click to edit title"
          }
        },
        "fillColor": "color1",
        "borderColor": "color2",
        "borderRadius": 8
      }
    },
    "charts": {
      "defaults": {
        "showTitle": true,
        "properties": {
          "widget.legend.position": "top",
          "widget.legend.splitter": false,
          "widget.legend.titleVisible": false
        }
      },
      "cartesianDefaults": {
        "properties": {
          "itemAxis.title.visible": false,
          "valueAxis.title.visible": false,
          "itemAxis.gridLines.visible": true,
          "itemAxis.ticks.labels.visible": true,
          "valueAxis.ticks.labels.visible": true,
          "itemAxis.line.visible": true,
          "valueAxis.line.visible": true,
          "valueAxis.gridLines.dashPattern.type": "dot",
          "itemAxis.gridLines.dashPattern.type": "dot"
        }
      },
      "pieDefaults": {
        "globalFormat": {
          "ZerosOption": "AUTO",
          "ScalingFactor": 1,
          "Notation": "COMPACTSHORT",
          "Units": {
            "UnitType": "BASE"
          },
          "Precision": {
            "MaxFraction": 1,
            "MinFraction": 1
          },
          "GroupingStrategy": "AUTO",
          "SignDisplay": "AUTO",
          "Locale": "en",
          "selectedFormat": "none"
        },
        "properties": {
          "widget.legend.position": "bottom",
          "donut.hole.radius": 0.7,
          "label.percentage": true,
          "labels.visible": true
        }
      },
      "byVisId": {
        "com.ibm.vis.rave2line": {
          "properties": {
            "lineWithPoints.symbol": "donutPlus",
            "interpolate": "cardinal",
            "valueLabels.visible": true
          }
        },
        "com.ibm.vis.rave2bundlearea": {
          "properties": {
            "widget.legend.display": false,
            "lineWithPoints.symbol": "donutPlus",
            "interpolate": "cardinal",
            "valueLabels.visible": true
          }
        },
        "com.ibm.vis.rave2bundlebar": {
          "properties": {
            "valueLabels.visible": true,
            "itemAxis.ticks.labels.alignment": "left"
          }
        },
        "com.ibm.vis.rave2bundlecolumn": {
          "properties": {
            "valueLabels.visible": false
          }
        },
        "com.ibm.vis.rave2bundlepie": {
          "properties": {
            "inner.label.title": {
              "translationTable": {
                "Default": " "
              }
            }
          }
        }
      }
    },
    "mdv": {
      "genericProperties": {
        "displayMode": "grid",
        "drawBorderLines": true,
        "drawZebraStrips": false,
        "showInnerBox": false,
        "isColorCells": false,
        "isGridEditable": true,
        "boldConsolidation": false,
        "abbreviateNumbers": false,
        "useCellFontSize": true,
        "isColumnIndent": true,
        "isRowIndent": false,
        "isShowExpandCollapseColumns": true,
        "isShowExpandCollapseRows": true,
        "UseColumnFocusedCharting": false
      }
    },
    "syncTile": {
      "data": {
        "hasSearchBar": true,
        "multipleSelection": false,
        "showHeader": false,
        "showIcon": false,
        "isShowOverflowMenu": false
      }
    },
    "singleCell": {
      "genericProperties": {
        "dimensionOverview_name": false,
        "dimensionOverview_iconography": true,
        "dimensionOverview_contextinformation": false,
        "dimensionOverview_sectionheaders": false,
        "dimensionOverview_sectionicons": false,
        "displayMode": "grid",
        "syncInfo": {

        },
        "boldConsolidation": true,
        "CommonAxisRange": true,
        "drawBorderLines": true,
        "isColorCells": false,
        "isColumnIndent": true,
        "isMemberSelectUseRowHeader": false,
        "isDeferredRecalcOnLeafUpdates": false,
        "isRowIndent": true,
        "isAutomaticRowHeaderWidth": true,
        "isShowExpandCollapseRows": true,
        "isShowExpandCollapseColumns": true,
        "UseColumnFocusedCharting": false,
        "rowHeaderWidthValue": {
          "0": 131
        },
        "tableStyle": "gridSummary",
        "isZoom80": null,
        "hideColsHeader": true,
        "hideRowsHeader": true,
        "visible": false,
        "isGridEditable": false,
        "abbreviateNumbers": false,
        "allowConsolidationTypeIn": false,
        "showInnerBox": false,
        "useCellFontSize": true
      },
      "sections": {
        "DataCell": {
          "font-size": "28"
        }
      }
    },
    "image": {
      "objectFit": "contain"
    },
    "conditionalFormatting": {
      "paletteId": "userPaletteColor",

      "rules": [

      ]
    }
  }
}
